      "command": [
        "sh",
        "-c",
        "f=$(ls ~/.local/share/applications/claude-*.desktop 2>/dev/null | head -n1); if [ -n \"$f\" ]; then kioclient exec \"$f\" 2>/dev/null || kioclient5 exec \"$f\"; else distrobox enter claude -- claude-desktop; fi"
      ],
      "window_class": "com.anthropic.claude",
      "fullscreen": "launch",
      "accent": "#D97757",
